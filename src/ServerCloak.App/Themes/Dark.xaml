<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours from JSComputers.Web app.css (:root[data-theme="dark"]) -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="TintColor">#0A84FF</Color>
    <Color x:Key="AccentColor">#FF453A</Color>
    <Color x:Key="GreenColor">#30D158</Color>
    <Color x:Key="AmberColor">#FF9F0A</Color>
    <Color x:Key="PurpleColor">#BF5AF2</Color>

    <SolidColorBrush x:Key="Bg" Color="#000000"/>
    <SolidColorBrush x:Key="Label" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Secondary" Color="#A3EBEBF5"/>
    <SolidColorBrush x:Key="Tertiary" Color="#4DEBEBF5"/>
    <SolidColorBrush x:Key="Fill" Color="#3D787880"/>
    <SolidColorBrush x:Key="FillStrong" Color="#5C787880"/>
    <SolidColorBrush x:Key="Material" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Separator" Color="#99545458"/>
    <SolidColorBrush x:Key="Highlight" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Tint" Color="#0A84FF"/>
    <SolidColorBrush x:Key="OnTint" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#FF453A"/>
    <SolidColorBrush x:Key="Green" Color="#30D158"/>
    <SolidColorBrush x:Key="Amber" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="Blue" Color="#64D2FF"/>
    <SolidColorBrush x:Key="Purple" Color="#BF5AF2"/>

    <!-- Glass -->
    <SolidColorBrush x:Key="Glass" Color="#A61C1C1E"/>
    <SolidColorBrush x:Key="GlassStrong" Color="#D92C2C2E"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#1A0A84FF"/>
    <SolidColorBrush x:Key="RowSelected" Color="#330A84FF"/>
    <Color x:Key="ShadowColor">#80000000</Color>
    <Color x:Key="Blob1">#660A84FF</Color>
    <Color x:Key="Blob2">#55BF5AF2</Color>
    <Color x:Key="Blob3">#30FF453A</Color>
</ResourceDictionary>
