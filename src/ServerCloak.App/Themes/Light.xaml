<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours from JSComputers.Web app.css (:root) -->
    <Color x:Key="BgColor">#F2F2F7</Color>
    <Color x:Key="TintColor">#007AFF</Color>
    <Color x:Key="AccentColor">#FF3B30</Color>
    <Color x:Key="GreenColor">#248A3D</Color>
    <Color x:Key="AmberColor">#B25000</Color>
    <Color x:Key="PurpleColor">#8944AB</Color>

    <SolidColorBrush x:Key="Bg" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Label" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Secondary" Color="#AD3C3C43"/>
    <SolidColorBrush x:Key="Tertiary" Color="#523C3C43"/>
    <SolidColorBrush x:Key="Fill" Color="#1F787880"/>
    <SolidColorBrush x:Key="FillStrong" Color="#33787880"/>
    <SolidColorBrush x:Key="Material" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Separator" Color="#2E3C3C43"/>
    <SolidColorBrush x:Key="Highlight" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="Tint" Color="#007AFF"/>
    <SolidColorBrush x:Key="OnTint" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Green" Color="#248A3D"/>
    <SolidColorBrush x:Key="Amber" Color="#B25000"/>
    <SolidColorBrush x:Key="Blue" Color="#007AFF"/>
    <SolidColorBrush x:Key="Purple" Color="#8944AB"/>

    <!-- Glass -->
    <SolidColorBrush x:Key="Glass" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="GlassStrong" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#14007AFF"/>
    <SolidColorBrush x:Key="RowSelected" Color="#24007AFF"/>
    <Color x:Key="ShadowColor">#30000000</Color>
    <Color x:Key="Blob1">#55007AFF</Color>
    <Color x:Key="Blob2">#458944AB</Color>
    <Color x:Key="Blob3">#30FF3B30</Color>
</ResourceDictionary>
